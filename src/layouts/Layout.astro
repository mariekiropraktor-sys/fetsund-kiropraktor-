---
// Skriftene ligger på vår egen server (ikke Google Fonts) av personvernhensyn
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/outfit";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  skjult?: boolean; // true = Google skal ikke indeksere siden (utkast)
}

const { title, description, image = site.heroBilde, type = "website", skjult = false } = Astro.props;
// En tittel med «|» eller klinikknavnet brukes som den er; ellers legges klinikknavnet til.
// Hold titler under ca. 60 tegn totalt, ellers kutter Google dem.
const fullTitle =
  title.includes(site.navn) || title.includes(" | ") ? title : `${title} | ${site.navn}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Strukturerte data hjelper Google å vise adresse, telefon og åpningstider
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Chiropractor",
  name: site.navn,
  image: new URL(site.heroBilde, Astro.site).href,
  url: Astro.site?.href,
  telephone: "+47 463 32 766",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Garderbakken 1",
    postalCode: "1900",
    addressLocality: "Fetsund",
    addressCountry: "NO",
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Wednesday", "Friday"], opens: "08:00", closes: "16:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Tuesday", "Thursday"], opens: "08:00", closes: "18:00" },
  ],
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.9", reviewCount: site.google.antall },
  sameAs: [site.facebook, site.instagram],
};
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {skjult && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nb_NO" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#innhold">Hopp til innholdet</a>
    <Header />
    <main id="innhold">
      <slot />
    </main>
    <Footer />
  </body>
</html>
