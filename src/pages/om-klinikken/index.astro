---
// Om klinikken: toppfelt med bilde av oss begge, kort om klinikken, slik vi jobber,
// kiropraktorene som to like store kort side om side, og praktisk info.
import SideHode from "../../components/SideHode.astro";
import Layout from "../../layouts/Layout.astro";
import BookingCTA from "../../components/BookingCTA.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { site, kiropraktorer } from "../../data/site";

const k = Object.fromEntries(kiropraktorer.map((p) => [p.id, p]));

// Rekkefølge: Marie, så Sara (besluttet 14. okt. 2026)
const bios = [
  {
    p: k.marie,
    tittel: "Kiropraktor, MNKF · medgründer",
    avsnitt: [
      "Marie tok mastergraden ved Welsh Institute of Chiropractic i 2015 og startet klinikken i hjembygda si i 2020. Hun har særlig kompetanse på svimmelhet og krystallsyke, og bruker VNG-briller for å stille presis diagnose. Nest etter kommer kjevesmerter og hodepine. Hun står også bak Krystallsykehjelpen.no, en fagside om krystallsyke og svimmelhet med øvelser på video.",
      "Ved siden av svimmelhet behandler hun mange med vanlige muskel- og skjelettplager: vond nakke, låst rygg, skuldersmerter, hodepine og plager i hofte, kne og fot.",
    ],
    personlig:
      "Marie er engasjert i Norsk Kiropraktorforening. På kontoret ligger ofte hunden Luna og bidrar med litt poteterapi.",
    nettside: "Maries nettside",
  },
  {
    p: k.sara,
    tittel: "Kiropraktor · medgründer",
    // Like mye tekst om Sara og Marie: to avsnitt og én personlig linje hver.
    avsnitt: [
      "Sara tok mastergraden ved University of South Wales i 2015 og jobbet blant annet ved Ullevål Kiropraktorklinikk og Bekken og barn på Storo før hun startet klinikken i 2020. Halebeinsmerter er hennes spesialisering, og hun har etterutdanning i behandling av gravide og spedbarn. Hun har også laget et nettkurs for halebeinsmerter, med egne programmer og øvelser på video.",
      "Ved siden av halebein og gravide behandler hun mange med prolaps og isjias, rygg- og nakkesmerter og idrettsskader.",
    ],
    personlig: "Sara bor på Årnes med familien og hunden Salsa, og er glad i friluftsliv og isbading året rundt.",
    nettside: "Saras nettside",
  },
];

// Mathilde er hos oss en kort periode til (beskjed fra Marie 19. okt. 2026: «3 uker til»).
// Kortet skjules automatisk ved neste publisering etter siste dag. Slett blokken når hun har sluttet.
const mathilde = {
  navn: "Mathilde Opsvik",
  bilde: "/bilder/wp/mathilde.webp",
  sisteDag: "2026-11-11",
  tekst:
    "Mathilde har over ti års erfaring med rygg- og nakkesmerter, skulderproblemer, bekkenplager, hofteplager og de fleste andre plager i muskler og ledd. Hun har 5-årig mastergrad i kiropraktikk og videreutdanning i sportsmassasje, tørrkopping, instrumentassistert bløtvevsbehandling, tørrnåling og kinesiotaping.",
};
const visMathilde = new Date() <= new Date(`${mathilde.sisteDag}T23:59:59`);
const sisteDagTekst = new Date(mathilde.sisteDag).toLocaleDateString("nb-NO", { day: "numeric", month: "long" });

const tilnaerming = [
  {
    tittel: "Grundig undersøkelse",
    tekst: "Vi tar oss tid til å finne ut hvorfor du har vondt, ikke bare hvor.",
  },
  {
    tittel: "En forklaring du forstår",
    tekst: "Du får vite hva vi finner, hva vi tror det skyldes, og hva planen er.",
  },
  {
    tittel: "Øvelser du kan gjøre selv",
    tekst: "Enkle øvelser og råd, så du kan hjelpe deg selv mellom timene.",
  },
];
---

<Layout
  title="Om klinikken og kiropraktorene"
  description="Fetsund Kiropraktorsenter ble startet i 2020 av kiropraktorene Marie Hermansen og Sara Nordanger. Les om klinikken og hva de har særlig erfaring med."
>
  <SideHode
    tittel="Om klinikken"
    ingress="Fetsund Kiropraktorsenter ble startet i 2020 av Marie Hermansen og Sara Nordanger, som studerte sammen i fire år i Wales. Klinikken ligger i det kjente «Rosenbergbygget» midt i Fetsund sentrum."
    smuler={[{ navn: "Om klinikken" }]}
  >
    <div class="btn-row">
      <a class="btn" href={site.booking}>Bestill time</a>
      <a class="btn btn--ghost" href="#kiropraktorene">Møt kiropraktorene</a>
    </div>
    <figure class="toppbilde" slot="side">
      <img src={site.heroBilde} alt="Marie Hermansen og Sara Nordanger i klinikken" width="800" height="600" />
      <figcaption>Marie og Sara</figcaption>
    </figure>
  </SideHode>

  <TrustStrip />

  <!-- Kort om klinikken og hvordan vi jobber -->
  <section class="section wrap">
    <div class="intro">
      <div class="intro__tekst">
        <span class="eyebrow">Klinikken</span>
        <h2 class="h2">Et lokalt helsetilbud</h2>
        <p class="muted">
          Vi ønsket å gi folk i Fetsund og omegn et godt helsetilbud nær der de bor. Lokalene er pusset opp, og bygget
          huser i dag alt fra fotterapeut og regnskapsfører til fotograf.
        </p>
        <p class="muted">
          Vi har en helhetlig tilnærming: din helse og trygghet er i fokus fra første samtale til siste oppfølging.
        </p>
      </div>
      <ol class="verdier">
        {
          tilnaerming.map((t) => (
            <li class="verdi">
              <h3 class="verdi__tittel">{t.tittel}</h3>
              <p class="muted">{t.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Kiropraktorene: to like store kort side om side -->
  <section class="section section--white" id="kiropraktorene">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Kiropraktorene</span>
        <h2 class="h2">Møt oss</h2>
        <p class="muted">
          Vi behandler begge alle typer muskel- og skjelettplager, og har i tillegg hvert vårt spesialfelt.
        </p>
      </div>

      <div class="bios">
        {
          bios.map(({ p, tittel, avsnitt, personlig, nettside }) => (
            <article class="bio" id={p.id}>
              <img class="bio__bilde" src={p.bilde} alt={`Kiropraktor ${p.navn}`} width="600" height="700" loading="lazy" />
              <div class="bio__tekst">
                <span class="eyebrow">{tittel}</span>
                <h3 class="bio__navn">{p.navn}</h3>
                <ul class="chip-list bio__felt" aria-label="Spesialfelt og interessefelt">
                  {p.spesialfelt.map((s) => (
                    <li>
                      <span class="chip chip--spesial">{s}</span>
                    </li>
                  ))}
                  {p.interessefelt.map((s) => (
                    <li>
                      <span class="chip">{s}</span>
                    </li>
                  ))}
                </ul>
                {avsnitt.map((a) => (
                  <p>{a}</p>
                ))}
                <p class="bio__personlig">{personlig}</p>
                <div class="btn-row bio__knapper">
                  <a class="btn" href={p.booking}>
                    Bestill hos {p.navn.split(" ")[0]}
                  </a>
                  <a class="btn btn--ghost" href={p.side}>
                    {nettside}
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      {
        visMathilde && (
          <article class="gjest" id="mathilde">
            <img class="gjest__bilde" src={mathilde.bilde} alt={`Kiropraktor ${mathilde.navn}`} width="160" height="160" loading="lazy" />
            <div class="gjest__tekst">
              <span class="eyebrow">Kiropraktor · hos oss til {sisteDagTekst}</span>
              <h3 class="gjest__navn">{mathilde.navn}</h3>
              <p>{mathilde.tekst}</p>
              <div class="btn-row">
                <a class="btn" href={site.booking}>Bestill hos Mathilde</a>
              </div>
            </div>
          </article>
        )
      }
    </div>
  </section>

  <!-- Praktisk -->
  <section class="section wrap">
    <div class="praktisk">
      <div class="praktisk__kort">
        <span class="eyebrow">Her finner du oss</span>
        <p class="praktisk__stor">{site.adresse}</p>
        <p class="muted">I «Rosenbergbygget» midt i Fetsund sentrum. Gratis parkering, og kort vei fra buss og tog.</p>
        <a class="mer" href="/kontakt-oss/">Kart og veibeskrivelse →</a>
      </div>
      <div class="praktisk__kort">
        <span class="eyebrow">Åpningstider</span>
        {
          site.apningstider.map((a) => (
            <p class="praktisk__stor">
              {a.dager} {a.tid}
            </p>
          ))
        }
        <p class="muted">Ring <a href={site.telefonLenke}>{site.telefon}</a>, eller bestill time på nett når det passer deg.</p>
        <a class="mer" href="/priser/">Se priser →</a>
      </div>
    </div>
  </section>

  <BookingCTA tittel="Usikker på hvem du skal velge?" tekst="Ring oss, så finner vi den kiropraktoren som passer best for plagene dine." />
</Layout>

<style>
  /* Toppbilde */
  .toppbilde {
    position: relative;
    margin: 0;
  }
  .toppbilde img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 18px 50px rgb(11 110 129 / 0.15);
  }
  .toppbilde figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: #fff;
    border-radius: 999px;
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 600;
  }

  /* Intro + verdier */
  .intro {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .intro__tekst {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 560px;
  }
  .verdier {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: verdi;
    display: grid;
    gap: 12px;
  }
  .verdi {
    counter-increment: verdi;
    background: var(--surface);
    border-radius: 18px;
    padding: 18px 22px;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    row-gap: 2px;
    align-items: center;
  }
  .verdi::before {
    content: counter(verdi);
    grid-row: span 2;
    align-self: start;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--flate);
    color: var(--teal);
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .verdi__tittel {
    font-size: 20px;
  }
  .verdi p {
    font-size: 15px;
  }

  /* Kiropraktorene */
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 640px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .bios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }
  .bio {
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 110px;
  }
  .bio__bilde {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 22%;
  }
  .bio__tekst {
    padding: clamp(22px, 3vw, 34px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }
  .bio__navn {
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.1;
  }
  .bio__felt {
    margin-bottom: 4px;
  }
  .bio__tekst p {
    font-size: 16px;
    line-height: 1.6;
  }
  .bio__personlig {
    color: var(--muted);
    font-style: italic;
  }
  .bio__knapper {
    margin-top: auto;
    padding-top: 6px;
  }
  .chip--spesial {
    background: var(--flate);
    border-color: var(--flate);
    color: var(--teal);
    font-weight: 600;
  }

  /* Mathilde – eget, mindre kort under Marie og Sara */
  .gjest {
    margin-top: clamp(16px, 2.5vw, 28px);
    background: var(--bg);
    border-radius: var(--radius);
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    gap: 18px 28px;
    align-items: center;
    scroll-margin-top: 110px;
  }
  @media (min-width: 700px) {
    .gjest {
      grid-template-columns: 160px 1fr;
    }
  }
  .gjest__bilde {
    width: clamp(110px, 18vw, 160px);
    height: clamp(110px, 18vw, 160px);
    border-radius: 50%;
    object-fit: cover;
    object-position: 39% 28%;
    border: 4px solid #fff;
    box-shadow: 0 8px 24px rgb(11 110 129 / 0.15);
  }
  .gjest__tekst {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 760px;
  }
  .gjest__navn {
    font-size: clamp(24px, 2.6vw, 30px);
  }
  .gjest__tekst p {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Praktisk */
  .praktisk {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }
  .praktisk__kort {
    background: var(--surface);
    border-radius: 20px;
    padding: clamp(22px, 3vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .praktisk__stor {
    font-family: var(--serif);
    font-size: clamp(22px, 2.4vw, 26px);
    line-height: 1.2;
  }
  .praktisk .mer {
    margin-top: auto;
    font-weight: 600;
  }
</style>
