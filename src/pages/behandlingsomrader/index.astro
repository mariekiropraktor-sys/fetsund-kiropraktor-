---
import SideHode from "../../components/SideHode.astro";
import Layout from "../../layouts/Layout.astro";
import BookingCTA from "../../components/BookingCTA.astro";
import { getCollection } from "astro:content";
import { spesialfelt, plager, kiropraktorer } from "../../data/site";

// Alle plager som har egen side. Før innholdet er importert vises listen fra site.ts.
const sider = (await getCollection("behandlingsomrade")).sort(
  (a, b) => a.data.rekkefolge - b.data.rekkefolge || a.data.tittel.localeCompare(b.data.tittel, "nb"),
);
const liste = sider.length
  ? sider.map((s) => ({
      navn: s.data.tittel,
      tekst: s.data.beskrivelse,
      lenke: `/behandlingsomrade/${s.id}/`,
      hvem: kiropraktorer.find((k) => k.id === s.data.kiropraktor)?.navn.split(" ")[0],
    }))
  : plager.map((p) => ({ ...p, hvem: undefined }));
---

<Layout
  title="Plager vi behandler"
  description="Kiropraktorene i Fetsund behandler nakke, rygg, skulder, hofte, kne og fot – og har egne spesialfelt for svimmelhet, halebeinsmerter, gravide og barn."
>
  <SideHode
    tittel="Plager vi behandler"
    ingress="Vi behandler alle typer muskel- og skjelettplager, fra akutte smerter til langvarige plager. Finn plagen din under, eller ring oss hvis du er usikker."
    smuler={[{ navn: "Plager vi behandler" }]}
  />

  <section class="wrap innhold stack omrader">
    <h2 class="h2">Spesialfelt</h2>
    <div class="spesial">
      {
        spesialfelt.map((s) => (
          <a class="card card-link spesial__kort" href={s.lenke}>
            <span class="eyebrow">Hos {s.hvem}</span>
            <h3>{s.navn}</h3>
            <p class="muted">{s.tekst}</p>
          </a>
        ))
      }
    </div>

    <h2 class="h2 omrader__tittel">Alle plager</h2>
    <ul class="arrow-list card alle">
      {
        liste.map((p) => (
          <li>
            <a href={p.lenke}>
              <span>
                <strong>{p.navn}</strong>
                {p.tekst && <small>{p.tekst}</small>}
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <BookingCTA />
</Layout>

<style>
  .omrader {
    gap: 24px;
  }
  .omrader__tittel {
    margin-top: 32px;
  }
  .spesial {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 16px;
  }
  .spesial__kort h3 {
    font-size: 22px;
    margin: 6px 0 8px;
  }
  .alle {
    max-width: 820px;
  }
</style>
