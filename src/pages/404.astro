---
import SideHode from "../components/SideHode.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Fant ikke siden" description="Siden du lette etter finnes ikke." ikkeFunnet>
  <SideHode tittel="Denne siden finnes ikke" ingress="Kanskje den har flyttet. Prøv en av disse:">
    <div class="btn-row">
      <a class="btn" href="/">Til forsiden</a>
      <a class="btn btn--ghost" href="/behandlingsomrader/">Plager vi behandler</a>
      <a class="btn btn--ghost" href="/blogg/">Blogg</a>
    </div>
  </SideHode>
</Layout>

<script>
  // Teller besøket i Vercel Web Analytics med adressen den besøkende faktisk prøvde
  // (ellers står alle som «/404»). Da ser vi hvilke gamle adresser som mangler videresending.
  import { inject, pageview } from "@vercel/analytics";
  inject({ framework: "astro", disableAutoTrack: true });
  pageview({ route: "/404", path: window.location.pathname });
</script>
