---
// Forsiden, bygget etter forsideforslaget som ble avtalt i okt. 2026.
// Rekkefølge: hero → tillitsstripe → plager → spesialfelt → anmeldelser → slik foregår en time → finn fram → bestill.
import Layout from "../layouts/Layout.astro";
import TrustStrip from "../components/TrustStrip.astro";
import BookingCTA from "../components/BookingCTA.astro";
import { site, plager, metoder, andreMetoder, kiropraktorer, anmeldelser, eksterne, mathilde, visMathilde, mathildeSisteDag } from "../data/site";

// Sara og Marie, Sara først.
const behandlere = ["sara", "marie"].map((id) => kiropraktorer.find((k) => k.id === id)!);
const alleMetoder = [...metoder, ...andreMetoder.filter((m) => m.lenke && !m.lenke.includes("vng"))];
// ["A", "B", "C"] → "a, b og c"
const stor = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const liste = (ord: string[]) =>
  (ord.length > 1 ? `${ord.slice(0, -1).join(", ")} og ${ord.at(-1)}` : ord[0] ?? "").toLowerCase();
---

<Layout
  title="Kiropraktor i Fetsund | Fetsund Kiropraktorsenter"
  description="Kiropraktorene Sara Nordanger og Marie Hermansen i Fetsund sentrum: trygg hjelp for nakke, rygg og ledd. 4,9 på Google. Gratis parkering, ingen henvisning."
>
  <!-- Hero: samme oppbygging som Marie-siden – dempet turkis flate, tekst til venstre, bilde til høyre -->
  <div class="hero-ramme">
    <section class="hero">
      <div class="hero__tekst stack">
        <span class="eyebrow eyebrow--lys">Kiropraktorer i Fetsund sentrum</span>
        <h1 class="h1">Trygg hjelp for nakke, rygg og ledd</h1>
        <p class="lead">
          Hos oss får du grundig undersøkelse, målrettet behandling og øvelser du kan gjøre selv. Sara og Marie behandler
          alle typer muskel- og leddplager – og har i tillegg hvert sitt spesialfelt.
        </p>
        <div class="btn-row">
          <a class="btn btn--bright" href={site.booking}>Bestill time på nett</a>
          <a class="btn btn--outline-light" href="#plager">Hva kan vi hjelpe med?</a>
        </div>
        <p class="hero__note">Gratis parkering · 6 minutter fra Lillestrøm og Sørumsand · Ingen henvisning nødvendig</p>
      </div>
      <figure class="hero__bilde">
        <img
          src={site.heroBilde}
          alt="Kiropraktorene Marie Hermansen og Sara Nordanger i klinikken"
          width="1320"
          height="909"
          fetchpriority="high"
        />
        <div class="navnelapper">
          <a href={eksterne.marie}>Marie Hermansen</a>
          <a href={eksterne.sara}>Sara Nordanger</a>
        </div>
      </figure>
    </section>
  </div>

  <TrustStrip />

  <!-- Det begge behandler -->
  <section class="section wrap" id="plager">
    <div class="section-head">
      <h2 class="h2">Hva kan vi hjelpe deg med?</h2>
      <p class="muted">
        De fleste som kommer til oss har helt vanlige muskel- og leddplager – akutte eller langvarige. Dette behandler vi
        begge, hver dag.
      </p>
    </div>
    <div class="plager">
      {
        plager.map((p) => (
          <a class="plager__kort" href={p.lenke}>
            <strong>{p.navn}</strong>
            <span>{p.tekst}</span>
          </a>
        ))
      }
    </div>
    <a class="mer" href="/behandlingsomrader/">Se alle plager vi behandler →</a>
  </section>

  <!-- Spesialfelt – kort og rolig -->
  <section class="section section--white" id="kiropraktorene">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Og litt ekstra fordypning</h2>
        <p class="muted">
          Begge behandler alle typer muskel- og skjelettplager, og det er det de fleste kommer til oss med. I tillegg har
          vi hvert vårt felt vi har tatt ekstra utdanning i. Har du en av disse plagene, er det lurt å bestille hos den av
          oss som kan mest om akkurat det.
        </p>
      </div>
      <div class="fordypning">
        {
          behandlere.map((k) => (
            <article class="fordypning__kort">
              <img class="fordypning__bilde" src={k.bilde} alt={`Kiropraktor ${k.navn}`} width="140" height="140" loading="lazy" />
              <h3 class="fordypning__navn">{k.navn}</h3>
              <p class="fordypning__spesial">
                <span class="fordypning__etikett">Spesialfelt</span>
                <span>{stor(liste(k.spesialfelt))}</span>
              </p>
              <p class="fordypning__interesse muted">Interessefelt: {liste(k.interessefelt)}</p>
              <a class="btn fordypning__btn" href={k.booking}>
                Bestill hos {k.navn.split(" ")[0]}
              </a>
              <a class="mer fordypning__mer" href={k.side}>
                Les mer om {k.navn.split(" ")[0]} →
              </a>
            </article>
          ))
        }
      </div>
      {
        visMathilde && (
          <aside class="mathilde">
            <img class="mathilde__bilde" src={mathilde.bilde} alt={`Kiropraktor ${mathilde.navn}`} width="600" height="400" loading="lazy" />
            <div class="mathilde__tekst">
              <span class="eyebrow">Kiropraktor · hos oss til {mathildeSisteDag}</span>
              <h3 class="mathilde__navn">{mathilde.navn}</h3>
              <p class="muted">{mathilde.kort}</p>
              <div class="mathilde__knapper">
                <a class="btn" href={mathilde.booking}>Bestill hos Mathilde</a>
                <a class="mer" href="/om-klinikken/#mathilde">Les mer →</a>
              </div>
            </div>
          </aside>
        )
      }
    </div>
  </section>

  <!-- Google-vurderinger -->
  <section class="section wrap vurderinger" id="vurderinger">
    <div class="vurderinger__topp">
      <div class="stack">
        <h2 class="h2">Hva pasientene sier</h2>
        <p class="muted vurderinger__snitt">
          <span class="google__stjerner" aria-hidden="true">★★★★★</span>
          <span><strong>{site.google.vurdering} av 5</strong> basert på {site.google.antall} anmeldelser på Google</span>
        </p>
      </div>
      <a class="mer" href={site.google.lenke}>Les alle på Google →</a>
    </div>
    {
      anmeldelser.length > 0 && (
        <div class="sitater">
          {anmeldelser.map((a) => (
            <figure class="sitat">
              <span class="google__stjerner" role="img" aria-label="5 av 5 stjerner">
                ★★★★★
              </span>
              <blockquote>«{a.tekst}»</blockquote>
              <figcaption class="muted">Google-anmeldelse{a.om && ` om ${a.om}`}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </section>

  <!-- Slik foregår en time -->
  <section class="section wrap" id="behandling">
    <h2 class="h2 steg__tittel">Slik foregår en time</h2>
    <ol class="steg">
      <li>
        <span class="steg__nr">1</span>
        <h3>Samtale</h3>
        <p class="muted">Hva plager deg, når startet det, og hva gjør det bedre eller verre? Ofte den viktigste ledetråden.</p>
      </li>
      <li>
        <span class="steg__nr">2</span>
        <h3>Undersøkelse</h3>
        <p class="muted">Bevegelse, muskler, ledd og nerver – og flere tester ved behov.</p>
      </li>
      <li>
        <span class="steg__nr">3</span>
        <h3>Behandling og øvelser</h3>
        <p class="muted">Tilpasset det vi finner, og øvelser du kan gjøre hjemme. Henvisning videre hvis noe bør utredes.</p>
      </li>
    </ol>
    <div class="metoder">
      <span class="metoder__tittel">Metodene vi bruker</span>
      <ul class="chip-list">
        {
          alleMetoder.map((m) => (
            <li>
              <a class="chip-link" href={m.lenke}>
                {m.navn} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li><a class="chip-link" href="/behandlingsmetoder/">Alle metoder <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </section>

  <!-- Finn fram -->
  <section class="section section--white" id="finn-fram">
    <div class="wrap finn">
      <div class="stack">
        <h2 class="h2">Finn fram</h2>
        <p class="finn__adresse">{site.navn}<br />{site.adresse}</p>
        <p class="muted">
          Midt i sentrum, med gratis parkering og kort gangvei fra buss og tog. Ca. 6 minutter med bil fra Lillestrøm og
          Sørumsand.
        </p>
        <a class="mer" href="/kontakt-oss/">Kontakt og veibeskrivelse →</a>
      </div>
      <div class="finn__boks">
        <span class="finn__etikett">Åpningstider</span>
        <p>
          {
            site.apningstider.map((a) => (
              <>
                {a.dager}: {a.tid}
                <br />
              </>
            ))
          }
        </p>
        <span class="finn__etikett">Telefon</span>
        <a class="finn__tlf" href={site.telefonLenke}>{site.telefon}</a>
      </div>
    </div>
  </section>

  <BookingCTA />
</Layout>

<style>
  /* Hvit flate rundt, som på Marie-siden */
  .hero-ramme {
    background: var(--surface);
  }
  .hero {
    display: flex;
    flex-direction: column;
    background: #3d7d8b; /* dempet turkis, lysere enn Marie-siden (hvit tekst holder fortsatt kontrastkravet) */
    color: #fff;
    overflow: hidden;
  }
  .hero__bilde {
    order: -1;
    position: relative;
    margin: 0;
  }
  .hero__bilde img {
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 460px;
    object-fit: cover;
    object-position: 55% 30%;
    /* Mobil: bildet tones gradvis over i den turkise flaten */
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
  }
  .navnelapper {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 34%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .navnelapper a {
    background: var(--surface);
    color: var(--ink);
    border-radius: 999px;
    padding: 4px 11px;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 14px rgb(16 25 35 / 0.15);
  }
  .navnelapper a:hover {
    background: var(--teal-soft);
  }
  .hero__tekst {
    gap: 22px;
    position: relative;
    margin-top: -40px;
    padding: 0 var(--gutter) clamp(40px, 8vw, 72px);
  }
  .hero .h1 {
    color: #fff;
  }
  .hero .lead {
    color: rgba(255, 255, 255, 0.82);
  }
  .hero__note {
    font-size: 15px;
    color: var(--teal-soft);
  }
  .eyebrow--lys {
    color: var(--teal-soft);
  }
  .btn--bright {
    background: var(--teal-bright);
    border-color: var(--teal-bright);
    color: var(--ink);
  }
  .btn--bright:hover {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }

  /* PC: tekst til venstre, bildet i en avrundet ramme til høyre */
  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 600px;
    }
    .hero__bilde {
      order: 0;
      align-self: center;
      justify-self: end;
      width: min(100%, 560px);
      margin-block: 56px;
      margin-right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    }
    .hero__bilde img {
      aspect-ratio: 1320 / 909;
      max-height: none;
      border-radius: 24px;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .navnelapper {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }
    .hero__tekst {
      align-self: center;
      margin-top: 0;
      padding-block: 64px 72px;
      padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) 48px;
    }
  }

  .google__stjerner {
    color: var(--star);
    letter-spacing: 1px;
  }

  .plager {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    gap: 10px;
  }
  .plager__kort {
    background: var(--surface);
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--ink);
  }
  .plager__kort strong {
    font-weight: 600;
  }
  .plager__kort span {
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
  }
  .plager__kort:hover {
    background: var(--flate);
  }
  .mer {
    font-weight: 600;
  }
  #plager .mer {
    display: inline-block;
    margin-top: 24px;
  }

  /* To kort side om side – også på mobil – med rundt bilde av hver av oss */
  .fordypning {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 2vw, 20px);
  }
  .fordypning__kort {
    background: var(--bg);
    border-radius: 20px;
    padding: clamp(18px, 3vw, 32px) clamp(12px, 2.5vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    min-width: 0;
  }
  .fordypning__bilde {
    width: clamp(84px, 14vw, 140px);
    height: clamp(84px, 14vw, 140px);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 4px solid #fff;
    box-shadow: 0 8px 24px rgb(11 110 129 / 0.15);
  }
  .fordypning__navn {
    font-size: clamp(19px, 2.4vw, 26px);
  }
  .fordypning__spesial {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: clamp(15px, 1.6vw, 17px);
    font-weight: 500;
  }
  .fordypning__etikett {
    background: var(--flate);
    color: var(--teal);
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 13px;
    font-weight: 600;
  }
  .fordypning__interesse {
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.45;
  }
  .fordypning__btn {
    margin-top: auto;
    width: 100%;
    max-width: 260px;
    min-height: 44px;
    padding: 10px 12px;
    font-size: clamp(14px, 1.5vw, 16px);
  }
  .fordypning__mer {
    font-size: clamp(14px, 1.5vw, 16px);
  }
  @media (max-width: 520px) {
    .fordypning__interesse {
      display: none; /* holder kortene korte nok side om side på mobil */
    }
  }

  /* Mathilde – boks under Sara og Marie så lenge hun er her */
  .mathilde {
    margin-top: clamp(10px, 2vw, 20px);
    background: var(--bg);
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    align-items: stretch;
  }
  .mathilde__bilde {
    width: 100%;
    height: 100%;
    min-height: 150px;
    object-fit: cover;
    object-position: 40% 30%;
  }
  .mathilde__tekst {
    padding: clamp(14px, 3vw, 30px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }
  .mathilde__navn {
    font-size: clamp(20px, 2.4vw, 26px);
  }
  .mathilde__tekst .muted {
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.5;
  }
  .mathilde__knapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 4px;
  }
  .mathilde__knapper .btn {
    min-height: 44px;
    padding: 10px 18px;
    font-size: clamp(14px, 1.5vw, 16px);
  }
  @media (max-width: 560px) {
    .mathilde {
      grid-template-columns: 1fr;
    }
    .mathilde__bilde {
      aspect-ratio: 16 / 9;
      height: auto;
    }
    .mathilde__tekst .muted {
      display: none; /* kort og enkel på mobil */
    }
  }

  .vurderinger {
    padding-bottom: 0;
  }
  .vurderinger__topp {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }
  .vurderinger__snitt {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vurderinger__snitt strong {
    color: var(--ink);
    font-weight: 600;
  }
  .sitater {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .sitat {
    margin: 0;
    background: var(--surface);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sitat blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.4;
  }
  .sitat figcaption {
    font-size: 15px;
  }

  .steg__tittel {
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .steg {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(10px, 1.5vw, 16px);
  }
  /* Nummeret står til venstre for overskriften, så kortene blir lave på mobil */
  .steg li {
    background: var(--surface);
    border-radius: 18px;
    padding: clamp(16px, 2.4vw, 26px);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    row-gap: 4px;
    align-items: center;
    align-content: start;
  }
  .steg h3 {
    font-size: clamp(19px, 2vw, 22px);
  }
  .steg p {
    grid-column: 2;
    font-size: clamp(15px, 1.5vw, 16px);
    line-height: 1.5;
  }
  .steg__nr {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--flate);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
  }
  .metoder {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .metoder__tittel {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .finn {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .finn__adresse {
    font-size: 19px;
  }
  .finn__boks {
    background: var(--bg);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .finn__etikett {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .finn__etikett + p + .finn__etikett {
    padding-top: 8px;
  }
  .finn__tlf {
    font-size: 19px;
    font-weight: 600;
  }
</style>
