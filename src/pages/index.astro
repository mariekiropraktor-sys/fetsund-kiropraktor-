---
// Forsiden, bygget etter forsideforslaget som ble avtalt i okt. 2026.
// Rekkefølge: hero → tillitsstripe → plager → spesialfelt → anmeldelser → slik foregår en time → finn fram → bestill.
import Layout from "../layouts/Layout.astro";
import TrustStrip from "../components/TrustStrip.astro";
import BookingCTA from "../components/BookingCTA.astro";
import { site, plager, metoder, andreMetoder, kiropraktorer, anmeldelser } from "../data/site";

// Bare Sara og Marie på forsiden (Sara først). Mathilde: avklares.
const behandlere = ["sara", "marie"].map((id) => kiropraktorer.find((k) => k.id === id)!);
const alleMetoder = [...metoder, ...andreMetoder.filter((m) => m.lenke && !m.lenke.includes("vng"))];
// ["A", "B", "C"] → "a, b og c"
const liste = (ord: string[]) =>
  (ord.length > 1 ? `${ord.slice(0, -1).join(", ")} og ${ord.at(-1)}` : ord[0] ?? "").toLowerCase();
---

<Layout
  title="Kiropraktor i Fetsund | Fetsund Kiropraktorsenter"
  description="Kiropraktorene Sara Nordanger og Marie Hermansen i Fetsund sentrum: trygg hjelp for nakke, rygg og ledd. 4,9 på Google. Gratis parkering, ingen henvisning."
>
  <!-- Hero: lys turkis flate med bildet av Marie og Sara -->
  <div class="hero-ramme">
    <section class="hero">
      <div class="hero__tekst">
        <span class="eyebrow">Kiropraktorer i Fetsund sentrum</span>
        <h1 class="h1">Trygg hjelp for nakke, rygg og ledd</h1>
        <p class="lead">
          Hos oss får du grundig undersøkelse, målrettet behandling og øvelser du kan gjøre selv. Sara og Marie behandler
          alle typer muskel- og leddplager – og har i tillegg hvert sitt spesialfelt.
        </p>
        <div class="btn-row">
          <a class="btn" href={site.booking}>Bestill time på nett</a>
          <a class="btn btn--ghost" href="#plager">Hva kan vi hjelpe med?</a>
        </div>
        <a class="google" href={site.google.lenke}>
          <span class="google__stjerner" aria-hidden="true">★★★★★</span>
          <span><strong>{site.google.vurdering} på Google</strong> · {site.google.antall} anmeldelser</span>
        </a>
        <p class="hero__note">Gratis parkering · 6 minutter fra Lillestrøm og Sørumsand · Ingen henvisning nødvendig</p>
      </div>
      <div class="hero__bilde">
        <img
          src={site.heroBilde}
          alt="Kiropraktorene Marie Hermansen og Sara Nordanger i klinikken"
          width="1320"
          height="909"
          fetchpriority="high"
        />
        <div class="navnelapper" aria-hidden="true">
          <span>Marie Hermansen</span>
          <span>Sara Nordanger</span>
        </div>
      </div>
    </section>
  </div>

  <TrustStrip />

  <!-- Det begge behandler -->
  <section class="section wrap" id="plager">
    <div class="section-head">
      <h2 class="h2">Hva kan vi hjelpe deg med?</h2>
      <p class="muted">
        De fleste som kommer til oss har helt vanlige muskel- og leddplager – akutte eller langvarige. Dette behandler vi
        begge, hver dag.
      </p>
    </div>
    <div class="plager">
      {
        plager.map((p) => (
          <a class="plager__kort" href={p.lenke}>
            <strong>{p.navn}</strong>
            <span>{p.tekst}</span>
          </a>
        ))
      }
    </div>
    <a class="mer" href="/behandlingsomrader/">Se alle plager vi behandler →</a>
  </section>

  <!-- Spesialfelt – kort og rolig -->
  <section class="section section--white" id="kiropraktorene">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Og litt ekstra fordypning</h2>
        <p class="muted">
          I tillegg har vi hvert vårt felt vi har tatt ekstra utdanning i. Har du en av disse plagene, er det lurt å
          bestille hos den av oss som kan mest om akkurat det.
        </p>
      </div>
      <div class="fordypning">
        {
          behandlere.map((k) => (
            <article class="fordypning__kort">
              <h3 class="fordypning__navn">{k.navn}</h3>
              <p>
                <strong>Spesialfelt:</strong> {liste(k.spesialfelt)}
              </p>
              <p class="muted">Interessefelt: {liste(k.interessefelt)}</p>
              <div class="fordypning__lenker">
                <a class="btn" href={k.booking}>
                  Bestill hos {k.navn.split(" ")[0]}
                </a>
                <a class="mer" href={k.side}>
                  Les mer om {k.navn.split(" ")[0]} →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Google-vurderinger -->
  <section class="section wrap vurderinger" id="vurderinger">
    <div class="vurderinger__topp">
      <div class="stack">
        <h2 class="h2">Hva pasientene sier</h2>
        <p class="muted vurderinger__snitt">
          <span class="google__stjerner" aria-hidden="true">★★★★★</span>
          <span><strong>{site.google.vurdering} av 5</strong> basert på {site.google.antall} anmeldelser på Google</span>
        </p>
      </div>
      <a class="mer" href={site.google.lenke}>Les alle på Google →</a>
    </div>
    {
      anmeldelser.length > 0 && (
        <div class="sitater">
          {anmeldelser.map((a) => (
            <figure class="sitat">
              <span class="google__stjerner" role="img" aria-label="5 av 5 stjerner">
                ★★★★★
              </span>
              <blockquote>«{a.tekst}»</blockquote>
              <figcaption class="muted">Google-anmeldelse{a.om && ` om ${a.om}`}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </section>

  <!-- Slik foregår en time -->
  <section class="section wrap" id="behandling">
    <h2 class="h2 steg__tittel">Slik foregår en time</h2>
    <ol class="steg">
      <li>
        <span class="steg__nr">1</span>
        <h3>Samtale</h3>
        <p class="muted">Hva plager deg, når startet det, og hva gjør det bedre eller verre? Ofte den viktigste ledetråden.</p>
      </li>
      <li>
        <span class="steg__nr">2</span>
        <h3>Undersøkelse</h3>
        <p class="muted">Bevegelse, muskler, ledd og nerver – og flere tester ved behov.</p>
      </li>
      <li>
        <span class="steg__nr">3</span>
        <h3>Behandling og øvelser</h3>
        <p class="muted">Tilpasset det vi finner, og øvelser du kan gjøre hjemme. Henvisning videre hvis noe bør utredes.</p>
      </li>
    </ol>
    <div class="metoder">
      <span class="metoder__tittel">Metodene vi bruker</span>
      <ul class="chip-list">
        {
          alleMetoder.map((m) => (
            <li>
              <a class="chip-link" href={m.lenke}>
                {m.navn} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li><a class="chip-link" href="/behandlingsmetoder/">Alle metoder <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </section>

  <!-- Finn fram -->
  <section class="section section--white" id="finn-fram">
    <div class="wrap finn">
      <div class="stack">
        <h2 class="h2">Finn fram</h2>
        <p class="finn__adresse">{site.navn}<br />{site.adresse}</p>
        <p class="muted">
          Midt i sentrum, med gratis parkering og kort gangvei fra buss og tog. Ca. 6 minutter med bil fra Lillestrøm og
          Sørumsand.
        </p>
        <a class="mer" href="/kontakt-oss/">Kontakt og veibeskrivelse →</a>
      </div>
      <div class="finn__boks">
        <span class="finn__etikett">Åpningstider</span>
        <p>
          {
            site.apningstider.map((a) => (
              <>
                {a.dager}: {a.tid}
                <br />
              </>
            ))
          }
        </p>
        <span class="finn__etikett">Telefon</span>
        <a class="finn__tlf" href={site.telefonLenke}>{site.telefon}</a>
      </div>
    </div>
  </section>

  <BookingCTA />
</Layout>

<style>
  .hero-ramme {
    padding: clamp(12px, 2vw, 20px);
  }
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    background: var(--flate);
    border-radius: 28px;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
  }
  .hero__tekst {
    padding: clamp(32px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .hero .lead {
    color: #3a4a5c;
  }
  .hero__note {
    font-size: 15px;
    color: #3a4a5c;
  }
  .hero__bilde {
    position: relative;
    min-height: 360px;
  }
  .hero__bilde img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 30%;
  }
  .navnelapper {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .navnelapper span {
    background: var(--surface);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 6px 20px rgb(16 25 35 / 0.15);
  }

  .google {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border-radius: 999px;
    padding: 8px 16px 8px 12px;
    text-decoration: none;
    color: var(--ink);
    font-size: 15px;
  }
  .google strong {
    font-weight: 600;
  }
  .google__stjerner {
    color: var(--star);
    letter-spacing: 1px;
  }

  .plager {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    gap: 10px;
  }
  .plager__kort {
    background: var(--surface);
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--ink);
  }
  .plager__kort strong {
    font-weight: 600;
  }
  .plager__kort span {
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
  }
  .plager__kort:hover {
    background: var(--flate);
  }
  .mer {
    font-weight: 600;
  }
  #plager .mer {
    display: inline-block;
    margin-top: 24px;
  }

  .fordypning {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 16px;
  }
  .fordypning__kort {
    background: var(--bg);
    border-radius: 20px;
    padding: clamp(22px, 3vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fordypning__navn {
    font-size: 26px;
  }
  .fordypning__kort strong {
    font-weight: 600;
  }
  .fordypning__lenker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    padding-top: 6px;
  }

  .vurderinger {
    padding-bottom: 0;
  }
  .vurderinger__topp {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }
  .vurderinger__snitt {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vurderinger__snitt strong {
    color: var(--ink);
    font-weight: 600;
  }
  .sitater {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .sitat {
    margin: 0;
    background: var(--surface);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sitat blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.4;
  }
  .sitat figcaption {
    font-size: 15px;
  }

  .steg__tittel {
    margin-bottom: 32px;
  }
  .steg {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }
  .steg li {
    background: var(--surface);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .steg h3 {
    font-size: 24px;
  }
  .steg__nr {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--flate);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 600;
  }
  .metoder {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .metoder__tittel {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .finn {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .finn__adresse {
    font-size: 19px;
  }
  .finn__boks {
    background: var(--bg);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .finn__etikett {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .finn__etikett + p + .finn__etikett {
    padding-top: 8px;
  }
  .finn__tlf {
    font-size: 19px;
    font-weight: 600;
  }
</style>
