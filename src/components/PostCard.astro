---
import { temaNavn } from "../data/site";

interface Props {
  slug: string;
  title: string;
  tema: string;
  date: Date;
  image?: string;
  visBilde?: boolean;
  beskrivelse?: string; // vises bare der den sendes med (bloggoversikten)
  lesetid?: number;
  stor?: boolean; // bredt kort med bilde ved siden av teksten
}
const { slug, title, tema, date, image, visBilde = true, beskrivelse, lesetid, stor = false } = Astro.props;
const dato = date.toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" });
---

<a class:list={["card card-link post", { "post--stor": stor }]} href={`/${slug}/`} data-tema={tema}>
  {visBilde && image && <img src={image} alt="" loading="lazy" class="post__bilde" />}
  <div class="post__tekst">
    <span class="eyebrow">{temaNavn[tema]}</span>
    <h3 class="post__tittel">{title}</h3>
    {beskrivelse && <p class="post__beskrivelse">{beskrivelse}</p>}
    <span class="post__dato muted">
      {dato}{lesetid && <span class="post__lesetid">{lesetid} min lesing</span>}
    </span>
  </div>
</a>

<style>
  .post {
    padding: 0;
    overflow: hidden;
  }
  .post__tekst {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 24px 24px;
    flex: 1;
  }
  .post__bilde {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--line);
  }
  .post__tittel {
    font-size: 21px;
    line-height: 1.3;
  }
  .post__beskrivelse {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post__dato {
    font-size: 14px;
    margin-top: auto;
    padding-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  /* Stort kort: bildet til venstre, teksten til høyre (fra 800 px) */
  @media (min-width: 800px) {
    .post--stor {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
    }
    .post--stor .post__bilde {
      aspect-ratio: 4 / 3;
      height: 100%;
    }
    .post--stor .post__tekst {
      padding: clamp(28px, 3.5vw, 48px);
      justify-content: center;
      gap: 14px;
    }
    .post--stor .post__tittel {
      font-size: clamp(28px, 2.8vw, 36px);
      line-height: 1.15;
    }
    .post--stor .post__beskrivelse {
      font-size: 17px;
      -webkit-line-clamp: 4;
    }
    .post--stor .post__dato {
      margin-top: 8px;
    }
  }
</style>
