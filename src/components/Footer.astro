---
import { site, kiropraktorer } from "../data/site";
const ar = new Date().getFullYear();
const sara = kiropraktorer.find((k) => k.id === "sara")!;
const marie = kiropraktorer.find((k) => k.id === "marie")!;
---

<footer class="footer">
  <div class="wrap footer__inner">
    <span>© {ar} {site.navn} · Medlem av Norsk Kiropraktorforening</span>
    <span class="footer__lenker">
      <a href={sara.side}>Kiropraktor Sara</a>
      <a href={marie.side}>Kiropraktor Marie</a>
      <a href={site.facebook}>Facebook</a>
      <a href={site.instagram}>Instagram</a>
      <a href="/personvern/">Personvern</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #9fb0c2;
    font-size: 14px;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 22px;
  }
  .footer__lenker {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .footer a {
    color: #9fb0c2;
  }
  .footer a:hover {
    color: #fff;
  }
</style>
