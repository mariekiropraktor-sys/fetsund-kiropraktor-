---
import { site } from "../data/site";

interface Props {
  tittel?: string;
  tekst?: string;
}
const {
  tittel = "Klar for en vurdering?",
  tekst = "Bestill time på nett når det passer deg. Du trenger ikke henvisning.",
} = Astro.props;
---

<section class="cta">
  <div class="wrap cta__inner">
    <div class="stack">
      <h2 class="h2">{tittel}</h2>
      <p>{tekst}</p>
    </div>
    <div class="btn-row">
      <a class="btn" href={site.booking}>Bestill time på nett</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--flate);
    padding-block: clamp(56px, 8vw, 88px);
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
  }
  .cta p {
    color: #3a4a5c;
    max-width: 560px;
  }
</style>
