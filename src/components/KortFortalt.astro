---
// «Kort fortalt»: 3–4 punkter øverst i innlegg og fagsider, for dem som vil ha svaret raskt
interface Props {
  punkter: string[];
}
const { punkter } = Astro.props;
---

{
  punkter.length > 0 && (
    <aside class="kort-fortalt" aria-label="Kort fortalt">
      <p class="kort-fortalt__tittel">Kort fortalt</p>
      <ul>
        {punkter.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .kort-fortalt {
    background: var(--surface);
    border-radius: var(--radius);
    border-top: 4px solid var(--teal);
    padding: clamp(20px, 3vw, 28px) clamp(22px, 3vw, 32px);
    margin-bottom: clamp(28px, 4vw, 40px);
    font-size: 17px;
    line-height: 1.55;
  }
  .kort-fortalt__tittel {
    font-family: var(--serif);
    font-size: 22px;
    margin-bottom: 10px;
  }
  .kort-fortalt ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .kort-fortalt li {
    position: relative;
    padding-left: 1.4em;
  }
  .kort-fortalt li::before {
    content: "";
    position: absolute;
    left: 0.15em;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
  }
</style>
